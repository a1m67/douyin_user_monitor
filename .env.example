# SQLite database. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///data/app.db

# Optional API-only protection for modifying /api/short-drama requests.
# The browser dashboard does not store this token; prefer reverse-proxy access control for UI use.
ADMIN_API_TOKEN=

# Optional single-user browser login. Disabled by default for compatibility.
APP_AUTH_ENABLED=false
APP_AUTH_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_TTL_HOURS=168
APP_COOKIE_SECURE=auto
LEGACY_MONITOR_ENABLED=false
SCAN_RUN_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=14
OCR_ENABLED=false
OCR_TIMEOUT_SECONDS=15
OCR_API_URL=
OCR_API_KEY=

# Account scheduling. Each account can override CHECK_INTERVAL_MINUTES in the dashboard.
CHECK_INTERVAL_MINUTES=10
MAX_CONCURRENT_CHECKS=3
MAX_BACKOFF_MINUTES=60
SCHEDULER_POLL_SECONDS=15
CRAWLER_CIRCUIT_BREAKER_ENABLED=true
CRAWLER_CIRCUIT_FAILURE_THRESHOLD=3
CRAWLER_CIRCUIT_OPEN_MINUTES=20
DOUYIN_MAX_CONCURRENT_REQUESTS=3
DOUYIN_MIN_REQUEST_INTERVAL_SECONDS=0.5

# New-account baseline, daily incremental polling, and background history backfill.
INITIAL_SYNC_LIMIT=20
INCREMENTAL_FETCH_LIMIT=30
HISTORY_BACKFILL_PAGE_SIZE=20
HISTORY_BACKFILL_DELAY_MIN_SECONDS=3
HISTORY_BACKFILL_DELAY_MAX_SECONDS=6
MAX_CONCURRENT_HISTORY_BACKFILLS=1
NOTIFY_ON_INITIAL_SYNC=false
AUTO_ACCEPT_CONFIDENCE=0.8

# Optional OpenAI-compatible episode parser fallback. It is only called for
# unresolved short-drama/episode signals; obvious ordinary videos skip it.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_AUTO_ACCEPT_CONFIDENCE=0.90

# A browser-export JSON cookie list, JSON cookie object, or a plain Cookie header.
DOUYIN_COOKIE_FILE=data/cookies.json

# Optional crawler YAML override. Otherwise config/douyin_web.yaml is used when present,
# then config/douyin_web.example.yaml as a non-working sample fallback.
DYMON_CRAWLER_CONFIG=config/douyin_web.yaml

# Leave notification variables empty to disable that channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_WEBHOOK_URL=
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_MAX_BACKOFF_SECONDS=3600
NOTIFICATION_CLAIM_TIMEOUT_SECONDS=300
